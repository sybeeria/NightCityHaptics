#!/bin/sh
# Save in the game folder and use: /bin/sh /path/nch-steam-launch -- %command%
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
companion="$here/bin/x64/plugins/cyber_engine_tweaks/mods/nightCityHaptics/companion/night-city-haptics"
port=19870
while [ "$#" -gt 0 ]; do
    case "$1" in
        --companion) [ "$#" -ge 2 ] || exit 2; companion=$2; shift 2 ;;
        --port) [ "$#" -ge 2 ] || exit 2; port=$2; shift 2 ;;
        --) shift; break ;;
        *) echo "Night City Haptics: supply Steam's command after --" >&2; exit 2 ;;
    esac
done
[ "$#" -gt 0 ] || exit 2
if [ ! -x "$companion" ]; then
    echo "Night City Haptics: native companion missing; continuing with the game." >&2
    exec "$@"
fi
if [ "${LD_LIBRARY_PATH+x}" = x ]; then
    export NCH_STEAM_SAVED_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
else
    unset NCH_STEAM_SAVED_LD_LIBRARY_PATH
fi
if [ "${LD_PRELOAD+x}" = x ]; then
    export NCH_STEAM_SAVED_LD_PRELOAD="$LD_PRELOAD"
else
    unset NCH_STEAM_SAVED_LD_PRELOAD
fi
unset LD_LIBRARY_PATH LD_PRELOAD
exec "$companion" --steam --companion "$companion" --port "$port" -- "$@"
